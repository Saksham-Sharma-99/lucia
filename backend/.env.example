ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://lucia:lucia@localhost:5433/lucia
TEST_DATABASE_URL=postgresql+asyncpg://lucia:lucia@localhost:5433/lucia_test
REDIS_URL=redis://localhost:6379/0

# Fernet key (urlsafe base64, 32 bytes); also signs consent links. `make setup` generates it.
SECRET_KEY=
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=lucia_session
COOKIE_SECURE=false

# Public URL of this API (ngrok in dev); used for OAuth redirects and webhooks.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Slack app (global): api.slack.com/apps -> Basic Information / OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Google Cloud OAuth client (Web) + Pub/Sub topic for Gmail watch
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=projects/<project>/topics/<topic>
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Vapi (global): dashboard.vapi.ai -> API keys. The webhook secret is any random string.
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Platform Twilio account (a firm may bring its own)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Studio AI drafter (wand + section drafts); leave the key empty to disable it
OPENAI_API_KEY=
DRAFTER_MODEL=gpt-5.6-luna
DRAFTER_JUDGE_MODEL=gpt-5.6

# Model pickers (JSON list or comma-separated)
ALLOWED_MODELS=["gpt-5.6","gpt-5.6-sol","gpt-5.6-luna"]

# Password for seeded users (local dev only); leave empty to generate and print one per user
SEED_PASSWORD=lucia-dev
